---
import Icon from './Icon.astro';
import { site, footerLinks } from '../data/site';
const year = new Date().getFullYear(); // current year when the site is built
---
<footer class="sfoot">
  <!-- Black link bar (same as shingkhar.com .foot1) -->
  <section class="sfoot__bar">
    <div class="container">
      <ul class="sfoot__links">
        {footerLinks.map((l, i) => (
          <>
            {i > 0 && <li class="sfoot__sep" aria-hidden="true">|</li>}
            <li><a href={l.href} title={l.label}>{l.label}</a></li>
          </>
        ))}
      </ul>
    </div>
  </section>

  <!-- Grey band: 3D social icons + copyright (same as shingkhar.com .copyright) -->
  <section class="sfoot__copy">
    <div class="container">
      <ul class="sfoot__social">
        {site.social.map((s) => (
          <li>
            <a href={s.href} aria-label={s.name} target={s.href !== '#' ? '_blank' : undefined} rel="noopener">
              <Icon name={s.icon} size={18} />
            </a>
          </li>
        ))}
      </ul>
      <p class="sfoot__text">
        Copyright ©{year} <a href="/" title="Kia Bhutan">Kia Bhutan</a>. All Righrs Reserved.
        website designed and developed by <a href="https://abit.bt/" title="aBit Private Limited" target="_blank" rel="noopener">abit Private Limited</a>.
      </p>
    </div>
  </section>
</footer>

<style>
  .sfoot { font-size: 15px; }

  /* Black link bar */
  .sfoot__bar { background: #00040d; text-transform: uppercase; padding: 1rem 0 .9rem; }
  .sfoot__links { display: flex; justify-content: center; flex-wrap: wrap; gap: .3rem 1rem; margin: 0; padding: 0; list-style: none; color: #fff; }
  .sfoot__links a { color: #fff; text-decoration: none; transition: color .2s; }
  .sfoot__links a:hover { color: #c4c6c8; }
  @media (max-width: 480px) {
    .sfoot__bar { font-size: 12.5px; letter-spacing: .02em; }
    .sfoot__links { gap: .3rem .55rem; flex-wrap: nowrap; }
  }

  /* Grey band */
  .sfoot__copy { background: #c4c6c8; text-align: center; padding: 2.6rem 0 3rem; }

  /* 3D isometric social buttons */
  .sfoot__social { display: flex; justify-content: center; margin: 0 0 4.6rem; padding: 1rem 0 0; list-style: none; }
  .sfoot__social li { margin: 0 20px; }
  .sfoot__social a {
    position: relative; display: grid; place-items: center; width: 35px; height: 35px;
    background: #fff; color: #262626;
    transform: perspective(100px) rotate(-30deg) skew(25deg) translate(0, 0);
    box-shadow: -20px 20px 10px rgba(0, 0, 0, .5);
    transition: transform .5s, box-shadow .5s, background .5s, color .5s;
  }
  .sfoot__social a::before,
  .sfoot__social a::after { content: ''; position: absolute; background: #b1b1b1; transition: background .5s; }
  .sfoot__social a::before { top: 5px; left: -10px; width: 10px; height: 100%; transform: skewY(-45deg); }
  .sfoot__social a::after { top: 35px; left: -5px; width: 100%; height: 10px; transform: skewX(-45deg); }
  .sfoot__social a:hover,
  .sfoot__social a:focus-visible {
    color: #fff;
    transform: perspective(1000px) rotate(-30deg) skew(25deg) translate(20px, -20px);
    box-shadow: -50px 50px 50px rgba(0, 0, 0, .5);
  }
  .sfoot__social li:nth-child(1) a:is(:hover, :focus-visible) { background: #3b5999; }
  .sfoot__social li:nth-child(1) a:is(:hover, :focus-visible)::before { background: #2e4a86; }
  .sfoot__social li:nth-child(1) a:is(:hover, :focus-visible)::after { background: #4a69ad; }
  .sfoot__social li:nth-child(2) a:is(:hover, :focus-visible) { background: #55acee; }
  .sfoot__social li:nth-child(2) a:is(:hover, :focus-visible)::before { background: #4184b7; }
  .sfoot__social li:nth-child(2) a:is(:hover, :focus-visible)::after { background: #4d9fde; }
  .sfoot__social li:nth-child(3) a:is(:hover, :focus-visible) { background: #dd4b39; }
  .sfoot__social li:nth-child(3) a:is(:hover, :focus-visible)::before { background: #c13929; }
  .sfoot__social li:nth-child(3) a:is(:hover, :focus-visible)::after { background: #e83322; }

  /* Copyright line */
  .sfoot__text { margin: 0; font-size: 12px; line-height: 1.7; text-transform: uppercase; color: #212529; }
  .sfoot__text a { color: inherit; text-decoration: none; }
  .sfoot__text a:hover { text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    .sfoot__social a, .sfoot__social a::before, .sfoot__social a::after { transition: none; }
  }
</style>
